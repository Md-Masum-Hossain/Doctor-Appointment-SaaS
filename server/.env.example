CLOUDINARY_API_SECRET=your-api-secret
GEMINI_API_KEY=your_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=15000
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
